CREATE TABLE TB_CLIENTE (
    cod_cliente VARCHAR(255) PRIMARY KEY,
    nome_cliente VARCHAR(100),
    cpf_cliente VARCHAR(16),
    rua_cliente VARCHAR(50),
    num_rua VARCHAR(50),
    complemento VARCHAR(40),
    bairro VARCHAR(20),
    cidade VARCHAR(50),
    uf CHAR(2)
);

CREATE TABLE TB_CLIENTE_TELEFONE (
  cod_cliente VARCHAR(255),
  telefone_cliente VARCHAR(20),
  PRIMARY KEY (cod_cliente, telefone_cliente),
  FOREIGN KEY (cod_cliente)
    REFERENCES TB_CLIENTE (cod_cliente)
);

CREATE TABLE TB_VENDEDOR (
  cod_vendedor VARCHAR(255) PRIMARY KEY,
  nome_vendedor VARCHAR(100)
);

CREATE TABLE TB_CATEGORIA (
  cod_categoria VARCHAR(255) PRIMARY KEY,
  nome_categoria VARCHAR(100)
);

CREATE TABLE TB_PEDIDO (
  num_pedido INT PRIMARY KEY,
  data_pedido DATE,
  cod_cliente VARCHAR(255),
  cod_vendedor VARCHAR(255),
  FOREIGN KEY (cod_cliente)
    REFERENCES TB_CLIENTE (cod_cliente),
  FOREIGN KEY (cod_vendedor)
    REFERENCES TB_VENDEDOR (cod_vendedor)
);

CREATE TABLE TB_PRODUTO (
  cod_produto VARCHAR(255) PRIMARY KEY,
  nome_produto VARCHAR(100),
  cod_categoria VARCHAR(100),
  preco_unitario DECIMAL(10,2),
  FOREIGN KEY (cod_categoria)
    REFERENCES TB_CATEGORIA (cod_categoria)
);


CREATE TABLE TB_ITEM_PEDIDO (
  cod_pedido INT,
  cod_produto VARCHAR(255),
  quantidade INT,
  preco_unitario DECIMAL(10,2),
  PRIMARY KEY (cod_pedido,cod_produto),
  FOREIGN KEY (cod_pedido)
    REFERENCES TB_PEDIDO (num_pedido),
  FOREIGN KEY (cod_produto)
    REFERENCES TB_PRODUTO (cod_produto)
);

